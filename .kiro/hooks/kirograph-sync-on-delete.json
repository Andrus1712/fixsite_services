{
  "name": "KiroGraph Sync on Delete",
  "version": "1.0.0",
  "description": "Remove deleted files from the KiroGraph index immediately.",
  "when": {
    "type": "fileDeleted",
    "patterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.py",
      "**/*.go",
      "**/*.rs",
      "**/*.java",
      "**/*.cs",
      "**/*.rb",
      "**/*.php",
      "**/*.swift",
      "**/*.kt",
      "**/*.dart",
      "**/*.ex",
      "**/*.exs",
      "**/*.scala",
      "**/*.sc",
      "**/*.lua",
      "**/*.zig",
      "**/*.sh",
      "**/*.bash",
      "**/*.ml",
      "**/*.mli",
      "**/*.elm",
      "**/*.sol",
      "**/*.vue",
      "**/*.m",
      "**/*.yaml",
      "**/*.yml",
      "**/*.tf",
      "**/*.tfvars",
      "**/*.css",
      "**/*.scss",
      "**/*.sass",
      "**/*.html"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "kirograph sync-if-dirty 2>/dev/null || true"
  }
}
